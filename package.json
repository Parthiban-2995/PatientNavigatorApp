{
  "name": "patient-navigator-playwright",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "allure:clean": "node -e \"const fs=require('fs'); for (const path of ['allure-results','allure-report']) fs.rmSync(path, { recursive: true, force: true })\"",
    "pretest:e2e": "npm run allure:clean",
    "test:e2e": "playwright test",
    "pretest:e2e:headed": "npm run allure:clean",
    "test:e2e:headed": "playwright test --headed",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.51.0",
    "allure": "^3.3.0",
    "allure-commandline": "^2.33.0",
    "allure-playwright": "^3.3.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.20.0",
    "globals": "^16.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "zod": "^3.24.2"
  }
}
